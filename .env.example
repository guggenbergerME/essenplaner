# ============================================================
#  essenplaner – Konfiguration (Beispiel)
#  Kopiere diese Datei nach .env und passe die Werte an.
# ============================================================

## ===== Netzwerk =====
APP_PORT=80
APP_URL=https://essenplaner.guggbyte.com

## ===== Auth =====
SECRET_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
ADMIN_EMAIL=admin@example.com

## ===== E-Mail (SMTP) =====
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=app@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=app@example.com
SMTP_TLS=true

## ===== Entwicklung =====
DEV_MODE=false
